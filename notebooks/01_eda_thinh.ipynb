        "def assign_price_bucket(price):\n",
        "    if price < 100000:\n",
        "        return \"<100k\"\n",
        "    if price < 500000:\n",
        "        return \"100k-500k\"\n",
        "    if price < 1000000:\n",
        "        return \"500k-1M\"\n",
        "    if price < 5000000:\n",
        "        return \"1M-5M\"\n",
        "    return \">5M\"\n",
        "\n",
        "df[\"price_bucket_der\"] = df[\"price_current\"].apply(assign_price_bucket)\n",
        "\n",
        "review_denominator = df[\"review_count\"].replace(0, np.nan) if \"review_count\" in df.columns else np.nan\n",
        "if \"five_star_with_image_count\" in df.columns and \"review_count\" in df.columns:\n",
        "    df[\"five_star_img_rate\"] = (df[\"five_star_with_image_count\"] / review_denominator).fillna(0).clip(0, 1)\n",
        "else:\n",
        "    df[\"five_star_img_rate\"] = 0\n",
        "\n",
        "if \"has_video\" in df.columns:\n",
        "    has_video_num = df[\"has_video\"].astype(int)\n",
        "else:\n",
        "    has_video_num = 0\n",
        "\n",
        "if \"image_count\" in df.columns:\n",
        "    image_component = (df[\"image_count\"].clip(upper=10) / 10) * 40\n",
        "else:\n",
        "    image_component = 0\n",
        "\n",
        "df[\"content_quality_score\"] = image_component + has_video_num * 30 + (df[\"five_star_img_rate\"].clip(upper=0.3) / 0.3) * 30\n",
        "\n",
        "df[\"discount_band\"] = pd.cut(\n",
        "    df[\"discount_percent\"],\n",
        "    bins=[-0.01, 0, 5, 10, 20, 30, 50, 100],\n",
        "    labels=[\"0%\", \"1-5%\", \"6-10%\", \"11-20%\", \"21-30%\", \"31-50%\", \">50%\"],\n",
        ")\n",
        "\n",
        "df[[\"content_quality_score\", \"discount_band\"]].head()"
      ]
    },
