      "source": [
        "discount_stats = (\n",
        "    df.dropna(subset=[\"discount_band\", \"sold_count\"])\n",
        "    .groupby(\"discount_band\", observed=False)[\"sold_count\"]\n",
        "    .agg(avg_sold=\"mean\", median_sold=\"median\", sample_size=\"count\")\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "fig2 = px.bar(\n",
        "    discount_stats.sort_values(by=\"avg_sold\", ascending=False),\n",
        "    x=\"discount_band\",\n",
        "    y=\"avg_sold\",\n",
        "    color=\"sample_size\",\n",
        "    text_auto=True,\n",
        "    title=\"Lượt bán trung bình theo nhóm giảm giá\",\n",
        "    labels={\"discount_band\": \"Nhóm discount\", \"avg_sold\": \"Lượt bán TB\"},\n",
        ")\n",
        "fig2.update_traces(textposition=\"outside\")\n",
        "fig2.show()\n",
        "\n",
        "discount_stats"
      ]
    },
