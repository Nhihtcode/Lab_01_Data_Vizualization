      "source": [
        "mall_chart_df = df[df[\"is_mall\"] == True].copy()\n",
        "mall_chart_df = mall_chart_df.dropna(subset=[\"image_count\", \"sold_count\"])\n",
        "\n",
        "mall_chart_df[\"image_bucket\"] = pd.cut(\n",
        "    mall_chart_df[\"image_count\"],\n",
        "    bins=[-1, 3, 6, 9, 99],\n",
        "    labels=[\"0-3\", \"4-6\", \"7-9\", \"10+\"],\n",
        ")\n",
        "\n",
        "sold_by_img_bucket = (\n",
        "    mall_chart_df.groupby(\"image_bucket\", observed=False)[\"sold_count\"]\n",
        "    .mean()\n",
        "    .reset_index()\n",
        "    .sort_values(\"image_bucket\")\n",
        ")\n",
        "\n",
        "fig1b = px.bar(\n",
        "    sold_by_img_bucket,\n",
        "    x=\"image_bucket\",\n",
        "    y=\"sold_count\",\n",
        "    title=\"Lượt bán trung bình theo nhóm số ảnh\",\n",
        "    labels={\"image_bucket\": \"Nhóm số ảnh\", \"sold_count\": \"Lượt bán TB\"},\n",
        ")\n",
        "fig1b.show()"
      ]
    },
